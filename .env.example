# ==============================================================================
# AI-Powered Inventory Demand Forecasting & Optimization System
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME="Inventory Demand Forecasting & Optimization System"
APP_VERSION="1.0.0"

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory_forecast_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory_forecast_db

# Machine Learning & Forecasting
MODEL_REGISTRY_PATH=models
DEFAULT_FORECAST_HORIZON_DAYS=14
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=7

# CORS / Frontend Integration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Backend Server Config
API_HOST=0.0.0.0
API_PORT=8000
